<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SkiPass.Worker</RootNamespace>
    <UserSecretsId>skipass-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Namjerno jedina referenca na ostatak rjesenja - ugovor o poruci, ne cijela
         aplikacija. SkiPass.Worker je stvarno odvojen servis, ne dio API procesa. -->
    <ProjectReference Include="..\SkiPass.Contracts\SkiPass.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
    <PackageReference Include="MailKit" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
