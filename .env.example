# ============================================================
# SkiPass - konfiguracijske vrijednosti
# Kopirajte ovu datoteku u .env i popunite stvarne vrijednosti.
# Nijedna vrijednost odavde ne smije biti hardkodirana u kodu
# niti u appsettings.json datoteci.
# ============================================================

# --- Baza podataka (naziv baze je broj indeksa bez IB prefiksa) ---
DB_HOST=localhost,1433
DB_NAME=210116
DB_USER=sa
DB_PASSWORD=PromijeniOvuLozinku123!

# --- JWT (kljuc mora imati najmanje 32 znaka) ---
JWT_KEY=promijeni-ovaj-kljuc-na-najmanje-32-znaka
JWT_ISSUER=SkiPass.API
JWT_AUDIENCE=SkiPass.Clients
JWT_EXPIRY_MINUTES=480

# --- Seed korisnici (lozinke demo naloga) ---
SEED_ADMIN_PASSWORD=test
SEED_STAFF_PASSWORD=test
SEED_SKIER_PASSWORD=test

# --- RabbitMQ (konzumira ga SkiPass.Worker - vidi docker-compose.yml) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- SMTP (slanje e-mailova iz pomocnog servisa) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=noreply@skipass.ba
SMTP_FROM_NAME=SkiPass

# --- Stripe (sandbox/test nalog - besplatna registracija na dashboard.stripe.com) ---
# Secret/Publishable kljucevi se uzimaju sa dashboard.stripe.com/test/apikeys.
# Webhook secret se dobija pri kreiranju webhook endpointa (dashboard.stripe.com/test/webhooks)
# ili lokalno preko "stripe listen --forward-to localhost:5000/api/Payments/webhook/stripe".
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Lokalni razvoj bez Dockera (Windows autentifikacija na instaliranom SQL Serveru) ---
# Postavite na true da se umjesto DB_USER/DB_PASSWORD koristi Windows autentifikacija.
DB_TRUSTED_CONNECTION=false
